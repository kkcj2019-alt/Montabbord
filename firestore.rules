rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /enterprises/{enterpriseId} {
      allow read: if true;
      allow write: if true;
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }
    match /enterpriseIndex/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /licenseKeys/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'superadmin@mdb.app';
    }
    match /resetCodes/{document} {
      allow read, write: if request.auth != null;
    }
    match /superAdmin/{document} {
      allow read, write: if true;
    }
  }
}
